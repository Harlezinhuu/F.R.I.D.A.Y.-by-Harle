{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/renderer/src/**/*", "src/renderer/src/env.d.ts", "src/shared/**/*", "src/preload/api.d.ts"]
}
