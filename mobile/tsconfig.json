{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "three": [
        "./node_modules/@types/three"
      ],
      "three/*": [
        "./node_modules/@types/three/*"
      ],
      "@google/genai": [
        "./node_modules/@google/genai"
      ],
      "@mediapipe/tasks-vision": [
        "./node_modules/@mediapipe/tasks-vision"
      ]
    }
  },
  "include": [
    "src/**/*",
    "../src/renderer/src/env.d.ts",
    "../src/renderer/src/hud/nucleo.ts",
    "../src/renderer/src/voz/live.ts",
    "../src/renderer/src/voz/audio.ts"
  ]
}