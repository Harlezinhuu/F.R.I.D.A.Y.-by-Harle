# Copie este arquivo para ".env" e preencha. O .env nunca vai para o GitHub.

# Chave grátis em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo do Gemini Live (áudio nativo). Troque se o Google lançar um mais novo.
FRIDAY_MODELO=gemini-2.5-flash-native-audio-preview-12-2025

# ---------- Voz ----------
# De onde vem a voz: "gemini" (mais rápida) ou "fish" (voz do Fish Audio)
FRIDAY_VOZ_PROVEDOR=gemini

# Voz do Gemini (Kore, Aoede, Leda, Zephyr...), usada quando o provedor é "gemini"
FRIDAY_VOZ=Kore

# Fish Audio: chave em https://fish.audio (API Keys) e o ID da voz escolhida
# (o ID aparece no endereço da página da voz: fish.audio/m/ESTE_ID)
FISH_API_KEY=
FISH_VOZ_ID=
# Modelo do Fish Audio. "s2.1-pro-free" é o do plano grátis de desenvolvedor.
FISH_MODELO=s2.1-pro-free
# Velocidade da fala, de 0.5 a 2.0
FISH_VELOCIDADE=1.05

# Efeito de "voz de IA" por cima da voz (1 = ligado, 0 = desligado)
FRIDAY_EFEITO_VOZ=1

# Cidade para o clima (vazio = localização aproximada pela internet)
FRIDAY_CIDADE=

# Saudação ao abrir, com clima e lembretes do dia (1 = ligada, 0 = desligada)
FRIDAY_SAUDACAO=1

# Cenas: foto e resumo da Wikipédia na tela enquanto ela fala (1 = ligadas, 0 = desligadas)
FRIDAY_CENAS=1

# Tarefas de programação com o Claude Code: tempo máximo de cada tarefa (minutos) e modelo (opcional)
FRIDAY_TAREFA_MINUTOS=30
FRIDAY_TAREFA_MODELO=

# Como a FRIDAY deve te chamar (opcional)
FRIDAY_NOME=

# Quanto silêncio (em milissegundos) conta como fim da sua frase. Menor = responde mais rápido,
# mas pode cortar você se fizer pausas longas. Padrão 500.
FRIDAY_FIM_DA_FALA_MS=500

# Segundos de silêncio até a FRIDAY encerrar a conversa sozinha
FRIDAY_SILENCIO_SEGUNDOS=20

# Reconhecimento facial (opcional, só liga quando alguém cadastra o rosto): quão parecido o rosto
# precisa ser para ela reconhecer, de 0.3 a 0.9. Maior = mais exigente. Padrão 0.5.
FRIDAY_ROSTO_LIMIAR=0.5

# Ligar o PC de fora de casa (opcional): nome grátis do DuckDNS (duckdns.org) para o endereço de casa
# nunca ficar velho quando a operadora troca o IP. Formato: nome:token (ex.: harle:1234abcd-...).
FRIDAY_DUCKDNS=

# Segundo cérebro (busca pelo assunto nos seus arquivos; o índice fica só no PC).
# Pastas que ela lê, separadas por ; (vazio = Documentos, Área de Trabalho e Downloads, mais os projetos).
FRIDAY_CEREBRO_PASTAS=
# 0 desliga o segundo cérebro.
FRIDAY_CEREBRO=1
